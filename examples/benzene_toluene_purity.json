{
  "format": "fluxsheet/1",
  "name": "Benzene-toluene column with purity spec",
  "description": "The rigorous benzene-toluene column of the distillation example, now designed by specification: the design spec PURITY adjusts the reflux ratio until the distillate holds 99.5 mol% benzene (results: Design specs). The sensitivity study REFLUX shows how purity and reboiler duty respond to the reflux ratio around that point.",
  "components": ["benzene", "toluene"],
  "property_method": "peng-robinson",
  "units": [
    {"id": "FEED", "type": "Feed", "ui": {"x": 40, "y": 120},
     "params": {"T": "90 degC", "P": "1.5 bar",
                "flows": {"benzene": "50 kmol/h", "toluene": "50 kmol/h"}}},
    {"id": "COLUMN", "type": "DistillationColumn", "ui": {"x": 260, "y": 120},
     "params": {"stages": 24, "feed_stage": 13, "P": "1 atm", "condenser": "total",
                "reboiler": "kettle", "reflux_ratio": 1.79, "distillate_rate": "50 kmol/h"}},
    {"id": "BENZENE", "type": "Product", "ui": {"x": 480, "y": 60}},
    {"id": "TOLUENE", "type": "Product", "ui": {"x": 480, "y": 190}}
  ],
  "streams": [
    {"id": "F", "from": "FEED.out", "to": "COLUMN.in"},
    {"id": "DIST", "from": "COLUMN.distillate", "to": "BENZENE.in"},
    {"id": "BOTT", "from": "COLUMN.bottoms", "to": "TOLUENE.in"}
  ],
  "design_specs": [
    {"id": "PURITY",
     "target": {"stream": "DIST", "property": "mole_fraction", "component": "benzene"},
     "value": 0.995,
     "vary": {"unit": "COLUMN", "param": "reflux_ratio", "lower": 1.2, "upper": 5}}
  ],
  "sensitivity": [
    {"id": "REFLUX",
     "vary": [{"unit": "COLUMN", "param": "reflux_ratio", "lower": 1.4, "upper": 3.4, "points": 9}],
     "outputs": [{"stream": "DIST", "property": "mole_fraction", "component": "benzene"},
                 {"unit": "COLUMN", "property": "reboiler_duty"}]}
  ]
}
